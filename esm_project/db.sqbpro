-- VALIDATED UUID SEED DATA FOR DJANGO CORE WORKLOADS
-- ============================================================================

PRAGMA foreign_keys = OFF;

-- Wipe previous incompatible string references safely
DELETE FROM monitoring_liveexecutionlog;
DELETE FROM monitoring_workflowexecution;
DELETE FROM engine_chain;

-- 1. SEED PARENT ENGINE CONFIGURATIONS
INSERT OR IGNORE INTO engine_chain (id, name, description, is_active, created_at) VALUES
(1, 'DATA_INGEST_MESH', 'Multi-Source Event Streaming Aggregator (*/5 * * * *)', 1, datetime('now')),
(2, 'RISK_VAL_ENGINE', 'ML-Driven Risk Assessment &amp; Margin Engine (0 * * * *)', 1, datetime('now')),
(3, 'WEEKEND_DEFRAG_MAINT', 'Database Index Defrag &amp; Cold Storage Archival', 1, datetime('now'));


-- 2. SEED WORKLOAD EXECUTIONS (Using real 32-character Hexadecimal UUID structures)

-- --- CHAIN 1: DATA_INGEST_MESH (References chain_id = 1) ---
INSERT INTO monitoring_workflowexecution (id, chain_id, process_no, status, triggered_by, started_at, ended_at) VALUES
('a0000000000000000000000000000001', '1', 9001, 'COMPLETED', 'SCHEDULER_DAEMON', datetime('now', '-20 minutes'), datetime('now', '-18 minutes')),
('a0000000000000000000000000000002', '1', 9002, 'COMPLETED', 'SCHEDULER_DAEMON', datetime('now', '-15 minutes'), datetime('now', '-12 minutes')),
('a0000000000000000000000000000003', '1', 9003, 'COMPLETED', 'SCHEDULER_DAEMON', datetime('now', '-10 minutes'), datetime('now', '-5 minutes')),
('a0000000000000000000000000000004', '1', 9004, 'RUNNING', 'SCHEDULER_DAEMON', datetime('now', '-2 minutes'), NULL);

-- --- CHAIN 2: RISK_VAL_ENGINE (References chain_id = 2) ---
INSERT INTO monitoring_workflowexecution (id, chain_id, process_no, status, triggered_by, started_at, ended_at) VALUES
('b0000000000000000000000000000001', '2', 9005, 'COMPLETED', 'SCHEDULER_DAEMON', datetime('now', '-45 minutes'), datetime('now', '-40 minutes')),
('b0000000000000000000000000000002', '2', 9006, 'COMPLETED', 'SCHEDULER_DAEMON', datetime('now', '-40 minutes'), datetime('now', '-35 minutes')),
('b0000000000000000000000000000003', '2', 9007, 'COMPLETED', 'SCHEDULER_DAEMON', datetime('now', '-35 minutes'), datetime('now', '-30 minutes')),
('b0000000000000000000000000000004', '2', 9008, 'FAILED', 'SCHEDULER_DAEMON', datetime('now', '-30 minutes'), datetime('now', '-28 minutes')),
('b0000000000000000000000000000005', '2', 9009, 'HOLD', 'SYSTEM_KERNEL', datetime('now'), NULL),
('b0000000000000000000000000000006', '2', 9010, 'HOLD', 'SYSTEM_KERNEL', datetime('now'), NULL);

-- --- CHAIN 3: WEEKEND_DEFRAG_MAINT (References chain_id = 3) ---
INSERT INTO monitoring_workflowexecution (id, chain_id, process_no, status, triggered_by, started_at, ended_at) VALUES
('c0000000000000000000000000000001', '3', 9011, 'COMPLETED', 'SYSTEM_ADMIN', datetime('now', '-5 hours'), datetime('now', '-4 hours')),
('c0000000000000000000000000000002', '3', 9012, 'COMPLETED', 'SYSTEM_ADMIN', datetime('now', '-4 hours'), datetime('now', '-4 hours')),
('c0000000000000000000000000000003', '3', 9013, 'COMPLETED', 'SYSTEM_ADMIN', datetime('now', '-4 hours'), datetime('now', '-3 hours')),
('c0000000000000000000000000000004', '3', 9014, 'COMPLETED', 'SYSTEM_ADMIN', datetime('now', '-3 hours'), datetime('now', '-3 hours')),
('c0000000000000000000000000000005', '3', 9015, 'COMPLETED', 'SYSTEM_ADMIN', datetime('now', '-3 hours'), datetime('now', '-2 hours')),
('c0000000000000000000000000000006', '3', 9016, 'COMPLETED', 'SYSTEM_ADMIN', datetime('now', '-2 hours'), datetime('now', '-2 hours')),
('c0000000000000000000000000000007', '3', 9017, 'COMPLETED', 'SYSTEM_ADMIN', datetime('now', '-2 hours'), datetime('now', '-1 hours')),
('c0000000000000000000000000000008', '3', 9018, 'COMPLETED', 'SYSTEM_ADMIN', datetime('now', '-1 hours'), datetime('now', '-1 hours')),
('c0000000000000000000000000000009', '3', 9019, 'COMPLETED', 'SYSTEM_ADMIN', datetime('now', '-1 hours'), datetime('now')),
('c0000000000000000000000000000010', '3', 9020, 'COMPLETED', 'SYSTEM_ADMIN', datetime('now'), datetime('now')),
('c0000000000000000000000000000011', '3', 9021, 'COMPLETED', 'SYSTEM_ADMIN', datetime('now'), datetime('now')),
('c0000000000000000000000000000012', '3', 9022, 'COMPLETED', 'SYSTEM_ADMIN', datetime('now'), datetime('now')),
('c0000000000000000000000000000013', '3', 9023, 'COMPLETED', 'SYSTEM_ADMIN', datetime('now'), datetime('now'));

PRAGMA foreign_keys = ON;</sql><current_tab id="0"/></tab_sql></sqlb_project>
